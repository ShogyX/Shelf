# EXAMPLE unit — illustrative only. `./install.sh` GENERATES the real unit from your actual paths
# with User=$RUN_USER and the venv it created; the /opt/WEB paths below are placeholders. If you
# copy this by hand, edit Documentation=/WorkingDirectory=/ExecStart= to your install dir and set a
# non-root User=. Prefer running install.sh.
[Unit]
Description=Shelf — self-hosted fiction reader (API + UI)
Documentation=file:/opt/WEB/README.md
After=network-online.target
Wants=network-online.target

[Service]
# Type=notify: the app sends READY=1 once it's serving, and pings the watchdog below.
Type=notify
NotifyAccess=main
WatchdogSec=120
WorkingDirectory=/opt/WEB/backend
# Bind on all interfaces; serve the built SPA from ../frontend/dist.
#
# SECURITY TRADEOFF — read this before pairing 0.0.0.0 with SHELF_TRUST_PROXY=1.
# trust_proxy makes the app take the client IP from CF-Connecting-IP / X-Forwarded-For, which is
# correct behind a tunnel/reverse proxy but is caller-controlled. Binding all interfaces means the
# origin is ALSO reachable directly (e.g. from the LAN), bypassing that proxy — and a direct caller
# can then vary the header per request. Every per-IP throttle keyed on it (the login lockout in
# app/auth.py, the service-token budget in app/service_auth.py) becomes a no-op for that caller.
# Set SHELF_HOST=127.0.0.1 if you reach Shelf ONLY through the tunnel — see cloudflare-tunnel.md.
# Keep 0.0.0.0 only if you deliberately want direct LAN access, and treat the per-IP rate limits as
# best-effort rather than a control you rely on.
Environment=SHELF_HOST=0.0.0.0
Environment=SHELF_PORT=8000
# Playwright browsers (for per-source render_js) live in root's cache.
Environment=PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright
ExecStart=/opt/WEB/backend/.venv/bin/python -m app
Restart=always
RestartSec=3
TimeoutStopSec=20
# Mixed: SIGTERM the main process (graceful), SIGKILL any lingering children.
KillMode=mixed
# Light hardening (relaxed enough for SQLite writes in /opt/WEB and the playwright cache).
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/WEB /root/.cache/ms-playwright

[Install]
WantedBy=multi-user.target
